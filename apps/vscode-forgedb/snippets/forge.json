{
  "Model Definition": {
    "prefix": "model",
    "body": [
      "${1:ModelName} {",
      "\tid: +uuid",
      "\t${2:field_name}: ${3:string}",
      "\tcreated_at: timestamp",
      "\tupdated_at: timestamp",
      "}"
    ],
    "description": "Create a new model"
  },
  "Model with Relations": {
    "prefix": "modelrel",
    "body": [
      "${1:ModelName} {",
      "\tid: +uuid",
      "\t${2:field_name}: ${3:string}",
      "\t",
      "\t// Relations",
      "\t${4:related}: [${5:RelatedModel}]",
      "\t",
      "\tcreated_at: timestamp",
      "\tupdated_at: timestamp",
      "}"
    ],
    "description": "Create a model with relations"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:StructName} {",
      "\t${2:field_name}: ${3:string}",
      "}"
    ],
    "description": "Create an inline struct (fixed-size fields only)"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": "enum ${1:EnumName} { ${2:Variant1}, ${3:Variant2} }",
    "description": "Create an enum type (PascalCase variants)"
  },
  "String Field": {
    "prefix": "fstring",
    "body": "${1:field_name}: string",
    "description": "String field (fields are required by default)"
  },
  "Optional String Field": {
    "prefix": "fstringopt",
    "body": "${1:field_name}: string?",
    "description": "Nullable string field"
  },
  "Unique String Field": {
    "prefix": "fstringuniq",
    "body": "${1:field_name}: &string",
    "description": "Unique string field (& = unique modifier)"
  },
  "Indexed String Field": {
    "prefix": "fstringidx",
    "body": "${1:field_name}: ^string",
    "description": "Indexed string field (^ = index modifier)"
  },
  "Email Field": {
    "prefix": "femail",
    "body": "${1:email}: ^&string @email",
    "description": "Unique, indexed email field with format validation"
  },
  "UUID Primary Key": {
    "prefix": "fid",
    "body": "id: +uuid",
    "description": "Auto-generated UUID primary key"
  },
  "Auto-increment ID": {
    "prefix": "fidauto",
    "body": "id: +u64",
    "description": "Auto-generated u64 primary key"
  },
  "Timestamp Field": {
    "prefix": "ftimestamp",
    "body": "${1:created_at}: timestamp",
    "description": "Timestamp field"
  },
  "Boolean Field": {
    "prefix": "fbool",
    "body": "${1:is_active}: bool",
    "description": "Boolean field"
  },
  "Number Field": {
    "prefix": "fnum",
    "body": "${1:count}: ${2|u32,u64,i32,i64,f64|}",
    "description": "Numeric field"
  },
  "Decimal Field": {
    "prefix": "fdecimal",
    "body": "${1:price}: decimal",
    "description": "Exact fixed-point decimal (money/quantity)"
  },
  "JSON Field": {
    "prefix": "fjson",
    "body": "${1:metadata}: json",
    "description": "Arbitrary JSON value (not filterable/sortable/indexable)"
  },
  "Array Relation": {
    "prefix": "farray",
    "body": "${1:items}: [${2:RelatedModel}]",
    "description": "One-to-many / many-to-many relation"
  },
  "Required Relation": {
    "prefix": "frel",
    "body": "${1:owner}: *${2:RelatedModel}",
    "description": "Required foreign-key reference (*Model)"
  },
  "Optional Relation": {
    "prefix": "frelopt",
    "body": "${1:editor}: ?${2:RelatedModel}",
    "description": "Optional foreign-key reference (?Model)"
  },
  "Char Field": {
    "prefix": "fchar",
    "body": "${1:code}: char(${2:10})",
    "description": "Fixed-length char field"
  },
  "Computed Field": {
    "prefix": "fcomputed",
    "body": "${1:full_name}: string @computed",
    "description": "Computed field (semantic-only marker)"
  },
  "Field with Min/Max": {
    "prefix": "fminmax",
    "body": "${1:age}: ${2:u32} @min(${3:0}) @max(${4:150})",
    "description": "Numeric field with min/max validation"
  },
  "Field with Length": {
    "prefix": "flength",
    "body": "${1:name}: string @length(${2:1}, ${3:100})",
    "description": "String field with length validation"
  },
  "Field with Pattern": {
    "prefix": "fpattern",
    "body": "${1:phone}: string @pattern(\"${2:^[0-9]+$}\")",
    "description": "String field with regex validation"
  },
  "Composite Index": {
    "prefix": "dindex",
    "body": "@index(${1:field1}, ${2:field2})",
    "description": "Model-level composite index directive"
  },
  "Default Value": {
    "prefix": "ddefault",
    "body": "@default(${1:value})",
    "description": "Default value directive (semantic-only marker)"
  },
  "On Delete Directive": {
    "prefix": "dondel",
    "body": "@on_delete(${1|restrict,cascade,set_null|})",
    "description": "On-delete referential policy (relation FK field)"
  },
  "Full Text Search": {
    "prefix": "dfulltext",
    "body": "@fulltext",
    "description": "Full-text search marker (semantic-only)"
  },
  "Soft Delete": {
    "prefix": "dsoftdelete",
    "body": "@soft_delete",
    "description": "Model-level soft-delete directive"
  },
  "Component Reference": {
    "prefix": "fcomponent",
    "body": "${1:card}: tsx://pages/${2:model}/${1}",
    "description": "TSX component reference"
  },
  "Component with Relations": {
    "prefix": "fcomponentrel",
    "body": "${1:card}: tsx://pages/${2:model}/${1} @relations(${3:*})",
    "description": "TSX component with relations"
  },
  "API Route Handler": {
    "prefix": "fapi",
    "body": "${1:verify}: api://routes/${2:model}/${1}",
    "description": "API route handler reference"
  },
  "User Model Template": {
    "prefix": "tuser",
    "body": [
      "User {",
      "\tid: +uuid",
      "\temail: ^&string @email",
      "\tusername: ^&string @length(3, 50)",
      "\tpassword_hash: string",
      "\tfull_name: string?",
      "\tavatar_url: string? @url",
      "\tis_active: bool @default(true)",
      "\tcreated_at: timestamp",
      "\tupdated_at: timestamp",
      "}"
    ],
    "description": "User model template"
  },
  "Blog Post Template": {
    "prefix": "tpost",
    "body": [
      "Post {",
      "\tid: +uuid",
      "\ttitle: string @length(1, 200)",
      "\tslug: ^&string",
      "\tcontent: string",
      "\tpublished: bool @default(false)",
      "\tauthor: *User",
      "\tcomments: [Comment]",
      "\tcreated_at: timestamp",
      "\tupdated_at: timestamp",
      "}"
    ],
    "description": "Blog post model template"
  },
  "Comment Template": {
    "prefix": "tcomment",
    "body": [
      "Comment {",
      "\tid: +uuid",
      "\tcontent: string @length(1, 1000)",
      "\tauthor: *User",
      "\tpost: *Post",
      "\tcreated_at: timestamp",
      "}"
    ],
    "description": "Comment model template"
  }
}
