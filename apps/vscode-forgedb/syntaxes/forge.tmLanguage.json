{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ForgeDB Schema",
  "scopeName": "source.forge",
  "patterns": [
    { "include": "#comments" },
    { "include": "#struct-definition" },
    { "include": "#enum-definition" },
    { "include": "#model-definition" },
    { "include": "#field-definition" },
    { "include": "#strings" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.forge",
          "match": "//.*$"
        }
      ]
    },
    "struct-definition": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9]*)\\s*(\\{)",
          "captures": {
            "1": { "name": "keyword.control.struct.forge" },
            "2": { "name": "entity.name.type.struct.forge" },
            "3": { "name": "punctuation.definition.block.begin.forge" }
          }
        }
      ]
    },
    "enum-definition": {
      "patterns": [
        {
          "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9]*)\\s*(\\{)",
          "captures": {
            "1": { "name": "keyword.control.enum.forge" },
            "2": { "name": "entity.name.type.enum.forge" },
            "3": { "name": "punctuation.definition.block.begin.forge" }
          }
        }
      ]
    },
    "model-definition": {
      "patterns": [
        {
          "match": "\\b([A-Z][a-zA-Z0-9]*)\\s*(\\{)",
          "captures": {
            "1": { "name": "entity.name.type.model.forge" },
            "2": { "name": "punctuation.definition.block.begin.forge" }
          }
        }
      ]
    },
    "field-definition": {
      "patterns": [
        { "include": "#field-name" },
        { "include": "#directives" },
        { "include": "#component-references" },
        { "include": "#relations" },
        { "include": "#field-types" },
        { "include": "#field-symbols" },
        { "include": "#type-reference" }
      ]
    },
    "field-name": {
      "patterns": [
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "variable.other.field.forge" }
          }
        }
      ]
    },
    "field-symbols": {
      "comment": "Prefix modifiers appear between the colon and the type name: + auto-generate, & unique, ^ index. ? is the nullable postfix (also valid as a prefix).",
      "patterns": [
        {
          "name": "keyword.operator.auto-generate.forge",
          "match": "\\+"
        },
        {
          "name": "keyword.operator.unique.forge",
          "match": "&"
        },
        {
          "name": "keyword.operator.index.forge",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.nullable.forge",
          "match": "\\?"
        }
      ]
    },
    "field-types": {
      "patterns": [
        {
          "name": "support.type.primitive.forge",
          "match": "\\b(string|bool|u32|u64|i32|i64|f64|uuid|timestamp|json|decimal)\\b"
        },
        {
          "match": "\\b(char)\\s*(\\()\\s*(\\d+)\\s*(\\))",
          "captures": {
            "1": { "name": "support.type.primitive.forge" },
            "3": { "name": "constant.numeric.forge" }
          }
        },
        {
          "comment": "Fixed-size array of a scalar type: [f64; 3], [char(255); 5]",
          "match": "(\\[)\\s*([a-z0-9]+(?:\\(\\d+\\))?)\\s*(;)\\s*(\\d+)\\s*(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.array.begin.forge" },
            "2": { "name": "support.type.primitive.forge" },
            "4": { "name": "constant.numeric.forge" },
            "5": { "name": "punctuation.definition.array.end.forge" }
          }
        }
      ]
    },
    "directives": {
      "comment": "Known directive set enumerated first (same scope, documents intent); a generic fallback covers any future/unknown @name. Optional (...) args are captured for both.",
      "patterns": [
        {
          "match": "(@(?:min|max|length|email|url|pattern|regex|default|index|computed|fulltext|materialized|on_delete|relations|soft_delete|projection))\\b(?:\\s*(\\()([^)]*)(\\)))?",
          "captures": {
            "1": { "name": "entity.name.tag.directive.forge" },
            "2": { "name": "punctuation.definition.directive-args.begin.forge" },
            "3": { "name": "variable.parameter.directive-arg.forge" },
            "4": { "name": "punctuation.definition.directive-args.end.forge" }
          }
        },
        {
          "match": "(@[a-zA-Z_][a-zA-Z0-9_]*)\\b(?:\\s*(\\()([^)]*)(\\)))?",
          "captures": {
            "1": { "name": "entity.name.tag.directive.forge" },
            "2": { "name": "punctuation.definition.directive-args.begin.forge" },
            "3": { "name": "variable.parameter.directive-arg.forge" },
            "4": { "name": "punctuation.definition.directive-args.end.forge" }
          }
        }
      ]
    },
    "relations": {
      "comment": "*Model required FK, ?Model optional FK, [Model] one-to-many / many-to-many.",
      "patterns": [
        {
          "match": "(\\*)([A-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": { "name": "keyword.operator.relation.required.forge" },
            "2": { "name": "entity.name.type.reference.forge" }
          }
        },
        {
          "match": "(\\?)([A-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": { "name": "keyword.operator.relation.optional.forge" },
            "2": { "name": "entity.name.type.reference.forge" }
          }
        },
        {
          "match": "(\\[)([A-Z][a-zA-Z0-9]*)(\\])",
          "captures": {
            "1": { "name": "punctuation.definition.array.begin.forge" },
            "2": { "name": "entity.name.type.reference.forge" },
            "3": { "name": "punctuation.definition.array.end.forge" }
          }
        }
      ]
    },
    "component-references": {
      "patterns": [
        {
          "name": "string.other.component.forge",
          "match": "\\b(tsx|jsx|api)://[a-zA-Z0-9_/.\\-]+"
        }
      ]
    },
    "type-reference": {
      "comment": "A bare PascalCase name used as a field type resolves to a declared enum or inline struct.",
      "patterns": [
        {
          "name": "entity.name.type.reference.forge",
          "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.forge",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.forge",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.begin.forge",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.block.end.forge",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.comma.forge",
          "match": ","
        }
      ]
    }
  }
}
