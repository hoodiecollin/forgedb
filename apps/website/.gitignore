# Local env overrides — real keys live in 1Password / GitHub Actions secrets, never here.
# `.env.example` (committed) documents the expected vars.
.env*.local

# Vercel CLI working dir (created by `vercel link` / `vercel build`; holds pulled env).
.vercel

# Local-only in-browser prose-rewrite dev tool. The POST route handler is
# incompatible with `output: "export"`, so it must never reach a deploy build;
# the queue is scratch state. Both stay on local working copies only.
app/api/dev-rewrite/
.rewrite-queue/
