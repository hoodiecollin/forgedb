{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeDB Inspector",
  "version": "0.1.0",
  "identifier": "dev.forgedb.inspector",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3200",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ForgeDB Inspector",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
