    ) -> std::result::Result<Option<Account>, ForgeDbError> {
        let url = format!("{}/api/account/{}", self.base_url, encode_segment(id));
        let response = self
            .http
            .get(&url)
            .send()
            .await
            .map_err(ForgeDbError::transport)?;
        if response.status().as_u16() == 404 {
            return Ok(None);
