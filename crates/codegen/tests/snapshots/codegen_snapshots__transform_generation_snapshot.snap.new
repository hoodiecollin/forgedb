#![allow(warnings)]
mod v1;
mod v2;
mod v3;
mod authored_m2;
fn transform_v1_to_v2(
    __src_dir: &std::path::Path,
    __dst_dir: &std::path::Path,
) -> ::std::result::Result<(), String> {
    std::fs::create_dir_all(__dst_dir).map_err(|e| format!("mkdir dst: {}", e))?;
    let __src = v1::Database::open_at(__src_dir.to_path_buf());
    let mut __dst = v2::Database::open_at(__dst_dir.to_path_buf());
    for __row in __src.user.all() {
        let mut __j = serde_json::to_value(&__row)
            .map_err(|e| format!("serialize {}: {}", "User", e))?;
        if let Some(__obj) = __j.as_object_mut() {
            __obj.insert("bio".to_string(), serde_json::from_str("null").unwrap());
        }
        let __rec: v2::User = serde_json::from_value(__j)
            .map_err(|e| format!("decode {} at v{}: {}", "User", 2u32, e))?;
        __dst.user.insert(__rec).map_err(|e| format!("insert {}: {:?}", "User", e))?;
    }
    __dst.commit().map_err(|e| format!("commit v{}: {}", 2u32, e))?;
    Ok(())
}
fn transform_v2_to_v3(
    __src_dir: &std::path::Path,
    __dst_dir: &std::path::Path,
) -> ::std::result::Result<(), String> {
    std::fs::create_dir_all(__dst_dir).map_err(|e| format!("mkdir dst: {}", e))?;
    let __src = v2::Database::open_at(__src_dir.to_path_buf());
    let mut __dst = v3::Database::open_at(__dst_dir.to_path_buf());
    for __row in __src.user.all() {
        let mut __j = serde_json::to_value(&__row)
            .map_err(|e| format!("serialize {}: {}", "User", e))?;
        __j = authored_m2::authored_transform("User", __j);
        let __rec: v3::User = serde_json::from_value(__j)
            .map_err(|e| format!("decode {} at v{}: {}", "User", 3u32, e))?;
        __dst.user.insert(__rec).map_err(|e| format!("insert {}: {:?}", "User", e))?;
    }
    __dst.commit().map_err(|e| format!("commit v{}: {}", 3u32, e))?;
    Ok(())
}
fn run(
    __src: &std::path::Path,
    __final_dst: &std::path::Path,
) -> ::std::result::Result<(), String> {
    if __final_dst.exists() {
        let __nonempty = std::fs::read_dir(__final_dst)
            .map(|mut d| d.next().is_some())
            .unwrap_or(false);
        if __nonempty {
            return Err(
                format!(
                    "destination {:?} exists and is non-empty; refusing to \
                             overwrite (the retained source dir is your rollback)",
                    __final_dst
                ),
            );
        }
    }
    let __parent = __final_dst
        .parent()
        .filter(|p| !p.as_os_str().is_empty())
        .map(|p| p.to_path_buf())
        .unwrap_or_else(|| std::path::PathBuf::from("."));
    let __work = __parent.join(".forgedb-transform-work");
    let _ = std::fs::remove_dir_all(&__work);
    std::fs::create_dir_all(&__work).map_err(|e| format!("mkdir work: {}", e))?;
    let __step_1 = __work.join(format!("v{}", 2u32));
    transform_v1_to_v2(__src, &__step_1)?;
    let __step_2 = __work.join(format!("v{}", 3u32));
    transform_v2_to_v3(&__step_1, &__step_2)?;
    if let Some(__p) = __final_dst.parent() {
        if !__p.as_os_str().is_empty() {
            let _ = std::fs::create_dir_all(__p);
        }
    }
    std::fs::rename(&__step_2, __final_dst)
        .map_err(|e| format!("atomic publish rename failed: {}", e))?;
    let _ = std::fs::remove_dir_all(&__work);
    Ok(())
}
fn main() {
    let __args: Vec<String> = std::env::args().collect();
    if __args.len() != 3 {
        eprintln!(
            "ForgeDB migration transformer (format v1 -> v3)\nusage: <this-bin> <src-data-dir> <dest-data-dir>"
        );
        std::process::exit(2);
    }
    let __src = std::path::PathBuf::from(&__args[1]);
    let __dst = std::path::PathBuf::from(&__args[2]);
    match run(&__src, &__dst) {
        Ok(()) => {
            println!(
                "\u{2713} migrated {:?} -> {:?} (format v{} -> v{})", __src, __dst, 1u32,
                3u32
            );
        }
        Err(__e) => {
            eprintln!("migration failed: {}", __e);
            std::process::exit(1);
        }
    }
}
