                        let mut __k = String::with_capacity(1 + __s.len());
                        __k.push('\u{1}');
                        __k.push_str(__s);
                        __k
                    }
                };
                std::sync::Arc::make_mut(&mut db.author_id_index)
                    .entry(__k)
                    .or_default()
                    .insert(__id);
            }
            {
                let __k: String = {
                    match &(editor_id_value) {
                        Some(__v) => {
                            let mut __buf = [0u8; 36];
                            let __s: &str = __v.hyphenated().encode_lower(&mut __buf);
                            let mut __k = String::with_capacity(1 + __s.len());
                            __k.push('\u{1}');
                            __k.push_str(__s);
                            __k
                        }
                        None => String::from('\u{0}'),
                    }
                };
                std::sync::Arc::make_mut(&mut db.editor_id_index)
                    .entry(__k)
                    .or_default()
                    .insert(__id);
            }
        }
        let _ = db.write_manifest(root);
