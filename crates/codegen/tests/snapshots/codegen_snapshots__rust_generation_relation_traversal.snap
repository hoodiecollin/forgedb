///Junction table for the Post.tags <-> Tag.posts many-to-many relation
pub struct PostTagLink {
    left_col: FixedColumn,
    right_col: FixedColumn,
    row_count: usize,
}
impl PostTagLink {
    /// Open the junction storage, rehydrating `row_count` from the
    /// persisted columns so M2M links survive a process restart
    /// (#65).  `right_col` is appended last in `link`, so its length
    /// is the count of fully-committed pairs; a torn link (left
    /// written, right not) is excluded and overwritten by the next.
    pub fn new() -> Self {
        let left_col = FixedColumn::new(
                PathBuf::from("post_tag_link/fixed/left.bin"),
                16usize,
            )
            .expect("Failed to create junction column");
        let right_col = FixedColumn::new(
                PathBuf::from("post_tag_link/fixed/right.bin"),
                16usize,
            )
            .expect("Failed to create junction column");
        let row_count = right_col.len();
        Self {
            left_col,
            right_col,
            row_count,
        }
    }
    /// Record a link between a `left` (model1) id and a `right`
    /// (model2) id.
    pub fn link(&mut self, left: Uuid, right: Uuid) {
        self.left_col.append_uuid(*left.as_bytes()).expect("Failed to append link");
        self.right_col.append_uuid(*right.as_bytes()).expect("Failed to append link");
        self.row_count += 1;
    }
    /// Every recorded (left, right) id pair.
    pub fn pairs(&self) -> Vec<(Uuid, Uuid)> {
        (0..self.row_count)
            .map(|i| {
                let left = Uuid::from_bytes(
                    self.left_col.read_uuid(i).expect("Failed to read link"),
                );
                let right = Uuid::from_bytes(
                    self.right_col.read_uuid(i).expect("Failed to read link"),
                );
                (left, right)
            })
            .collect()
    }
}
/// Main database struct
pub struct Database {
    pub user: UserStorage,
    pub post: PostStorage,
    pub tag: TagStorage,
    pub post_tag_link: PostTagLink,
}
impl Database {
    pub fn new() -> Self {
        Self {
            user: UserStorage::new(),
            post: PostStorage::new(),
            tag: TagStorage::new(),
            post_tag_link: PostTagLink::new(),
        }
    }
}
impl Database {
    ///Resolve the foreign key to its record.
    pub fn post_author(&self, record: &Post) -> Option<User> {
        self.user.get(record.author)
    }
    ///Resolve the optional foreign key to its record.
    pub fn post_editor(&self, record: &Post) -> Option<User> {
        record.editor.and_then(|fk| self.user.get(fk))
    }
    ///All Post whose author references the given id.
    pub fn user_posts_by_author(&self, id: Uuid) -> Vec<Post> {
        self.post.all().into_iter().filter(|record| record.author == id).collect()
    }
    ///All Post whose editor references the given id.
    pub fn user_posts_by_editor(&self, id: Uuid) -> Vec<Post> {
        self.post.all().into_iter().filter(|record| record.editor == Some(id)).collect()
    }
    ///Link a Post (left) and a Tag (right) in the junction table.
    pub fn link_post_tag(&mut self, left: Uuid, right: Uuid) {
        self.post_tag_link.link(left, right);
    }
    ///All linked Tag for the given Post id.
    pub fn post_tags(&self, id: Uuid) -> Vec<Tag> {
        self.post_tag_link
            .pairs()
            .into_iter()
            .filter(|(left, _)| *left == id)
            .filter_map(|(_, right)| self.tag.get(right))
            .collect()
    }
    ///All linked Post for the given Tag id.
    pub fn tag_posts(&self, id: Uuid) -> Vec<Post> {
        self.post_tag_link
            .pairs()
            .into_iter()
            .filter(|(_, right)| *right == id)
            .filter_map(|(left, _)| self.post.get(left))
            .collect()
    }
}
///Post with its forward references resolved
#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]
pub struct PostWithRelations {
    pub post: Post,
    pub author: Option<User>,
    pub editor: Option<User>,
}
impl Database {
    ///Load a record together with its forward references.
    pub fn post_with_relations(&self, id: Uuid) -> Option<PostWithRelations> {
        let post = self.post.get(id)?;
        let author = self.user.get(post.author);
        let editor = post.editor.and_then(|fk| self.user.get(fk));
        Some(PostWithRelations {
            post,
            author,
            editor,
        })
    }
}
