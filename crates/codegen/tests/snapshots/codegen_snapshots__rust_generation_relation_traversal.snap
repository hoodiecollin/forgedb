    Init { rows: Vec<Post> },
    /// A record newly entered the matching set.
    Added { row: Post },
    /// A record already in the set changed.
    Updated { row: Post },
    /// An id left the matching set (deleted, or no longer matches).
    Removed { id: Uuid },
}
///Live-query result-set delta for `Tag` (#62 Direction B): removal-aware membership changes over a generated closed-set query.
#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]
#[serde(tag = "kind", rename_all = "lowercase")]
