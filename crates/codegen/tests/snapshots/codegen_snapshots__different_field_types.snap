                .price_col
                .read_f64(__pslot)
                .expect("Failed to read from column");
            let active_value = __bufs
                .active_col
                .read_bool(__pslot)
                .expect("Failed to read from column");
            let created_at_value = Timestamp::from(
                __bufs
                    .created_at_col
                    .read_timestamp(__pslot)
                    .expect("Failed to read from column"),
            );
            __views
                .push(ComplexModelPageRef {
                    id: id_value,
                    count: count_value,
                    price: price_value,
                    active: active_value,
                    created_at: created_at_value,
                    __borrow: ::std::marker::PhantomData,
                });
        }
        f(__total, &__views)
    }
    pub fn reader(&self) -> ComplexModelStorageReader {
        ComplexModelStorageReader {
            id_to_row: self.id_to_row.clone(),
            id_versions: self.id_versions.clone(),
            id_col: self.id_col.reader().expect("Failed to open column reader"),
            count_col: self.count_col.reader().expect("Failed to open column reader"),
            price_col: self.price_col.reader().expect("Failed to open column reader"),
            active_col: self.active_col.reader().expect("Failed to open column reader"),
            created_at_col: self
                .created_at_col
                .reader()
                .expect("Failed to open column reader"),
            tombstones: self
                .tombstones
                .reader()
                .expect("Failed to open tombstones reader"),
        }
    }
}
pub struct ComplexModelStorageReader {
    id_to_row: std::sync::Arc<HashMap<Uuid, usize>>,
    id_versions: std::sync::Arc<HashMap<Uuid, Vec<usize>>>,
    id_col: forgedb_storage::FixedColumnReader,
    count_col: forgedb_storage::FixedColumnReader,
    price_col: forgedb_storage::FixedColumnReader,
    active_col: forgedb_storage::FixedColumnReader,
    created_at_col: forgedb_storage::FixedColumnReader,
    tombstones: forgedb_storage::TombstonesReader,
}
impl ComplexModelStorageReader {
    pub fn read_at(&self, row_index: usize) -> Option<ComplexModel> {
        if self.tombstones.is_deleted(row_index).unwrap_or(true) {
            return None;
        }
        let id_value = {
            let bytes = self
                .id_col
                .read_uuid(row_index)
                .expect("Failed to read from column");
            Uuid::from_bytes(bytes)
        };
        let count_value = self
            .count_col
            .read_i64(row_index)
            .expect("Failed to read from column");
        let price_value = self
            .price_col
            .read_f64(row_index)
            .expect("Failed to read from column");
        let active_value = self
            .active_col
            .read_bool(row_index)
            .expect("Failed to read from column");
        let created_at_value = Timestamp::from(
            self
                .created_at_col
                .read_timestamp(row_index)
                .expect("Failed to read from column"),
        );
        Some(ComplexModel {
            id: id_value,
            count: count_value,
            price: price_value,
            active: active_value,
            created_at: created_at_value,
        })
    }
    pub fn get_at(
        &self,
        snap: &forgedb_storage::Snapshot,
        id: Uuid,
    ) -> Option<ComplexModel> {
        let watermark = snap.watermark();
        let versions = self.id_versions.get(&id)?;
        let pos = versions.partition_point(|&r| r < watermark);
        if pos == 0 {
            return None;
        }
        self.read_at(versions[pos - 1])
    }
    pub fn all_at(&self, snap: &forgedb_storage::Snapshot) -> Vec<ComplexModel> {
        let watermark = snap.watermark();
        let mut rows = Vec::new();
        for versions in self.id_versions.values() {
            let pos = versions.partition_point(|&r| r < watermark);
            if pos == 0 {
                continue;
            }
            rows.push(versions[pos - 1]);
        }
        rows.sort_unstable();
        let mut records = Vec::new();
        for row in rows {
            if let Some(record) = self.read_at(row) {
                records.push(record);
            }
        }
        records
    }
}
fn validate_complex_model(record: &ComplexModel) -> Result<(), ValidationError> {
    Ok(())
}
