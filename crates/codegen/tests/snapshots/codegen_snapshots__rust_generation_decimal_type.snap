            self.id_col.append_uuid([0u8; 16]).expect("Failed to backfill column");
        }
        while self.price_col.len() < __anchor {
            self.price_col
                .append_uuid(rust_decimal::Decimal::ZERO.serialize())
                .expect("Failed to backfill column");
        }
        while self.discount_col.len() < __anchor {
            self.discount_col
                .append_bytes(
                    &vec![
                        0u8; std::mem::size_of:: < Option < rust_decimal::Decimal >> ()
                    ],
                )
                .expect("Failed to backfill column");
        }
        self.id_col
            .truncate_to_rows(__anchor)
            .expect("Failed to truncate column on recovery");
        self.price_col
            .truncate_to_rows(__anchor)
            .expect("Failed to truncate column on recovery");
        self.discount_col
            .truncate_to_rows(__anchor)
            .expect("Failed to truncate column on recovery");
        self.row_count = __anchor;
        let __entries = self
            .wal
            .replay(|_| -> std::io::Result<()> { Ok(()) })
            .expect("Failed to replay WAL on recovery");
        for __entry in &__entries {
            if let forgedb_wal::WalOperation::Raw { payload } = &__entry.operation {
                if payload.len() < 9 {
                    continue;
                }
                let mut __ri = [0u8; 8];
                __ri.copy_from_slice(&payload[0..8]);
                let __row_index = u64::from_le_bytes(__ri) as usize;
                if __row_index < self.row_count {
                    continue;
                }
                let __deleted = payload[8] != 0;
                let record: Product = match serde_json::from_slice(&payload[9..]) {
                    Ok(r) => r,
                    Err(_) => continue,
                };
                self.id_col
                    .append_uuid(*record.id.as_bytes())
                    .expect("Failed to append to column");
                self.price_col
                    .append_uuid(record.price.serialize())
                    .expect("Failed to append to column");
                {
                    let bytes = unsafe {
                        std::slice::from_raw_parts(
                            &record.discount as *const _ as *const u8,
                            std::mem::size_of_val(&record.discount),
                        )
                    };
                    self.discount_col
                        .append_bytes(bytes)
                        .expect("Failed to append to column");
                }
                self.tombstones
                    .append(__deleted)
                    .expect("Failed to append tombstone on recovery");
                self.row_count += 1;
            }
        }
    }
    /// Force a WAL checkpoint (#89 step 2): fsync this model's columns,
    /// then truncate its WAL.  Bounds the WAL and shortens reopen; not
    /// required for correctness (recovery reads the column lengths).
    pub fn checkpoint(&mut self) {
        self.id_col.flush().expect("Failed to fsync column on checkpoint");
        self.price_col.flush().expect("Failed to fsync column on checkpoint");
        self.discount_col.flush().expect("Failed to fsync column on checkpoint");
        self.tombstones.flush().expect("Failed to fsync tombstones on checkpoint");
        self.wal.truncate().expect("Failed to truncate WAL on checkpoint");
        self.writes_since_checkpoint = 0;
    }
