                    __k
                }
                Ok(__other) => {
                    let mut __k = String::from('\u{2}');
                    __k.push_str(&__other.to_string());
                    __k
                }
                Err(_) => String::from('\u{3}'),
            }
        };
        let __ids = match self.price_index.get(&__k) {
            Some(__s) => __s,
            None => return Vec::new(),
