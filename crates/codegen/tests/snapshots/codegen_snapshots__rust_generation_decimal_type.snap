                let bytes = self
                    .id_col
                    .read_uuid(row_index)
                    .expect("Failed to read id column");
                Uuid::from_bytes(bytes)
            };
            newest.insert(row_id, row_index);
        }
        let mut records = Vec::new();
        for row_index in 0..watermark {
            let row_id = {
                let bytes = self
                    .id_col
                    .read_uuid(row_index)
                    .expect("Failed to read id column");
                Uuid::from_bytes(bytes)
            };
            if newest.get(&row_id) == Some(&row_index) {
