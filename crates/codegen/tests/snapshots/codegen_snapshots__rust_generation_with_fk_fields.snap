                match serde_json::to_value(&(record.author_id)) {
                    Ok(serde_json::Value::Null) => String::from('\u{0}'),
                    Ok(serde_json::Value::String(__s)) => {
                        let mut __k = String::from('\u{1}');
                        __k.push_str(&__s);
                        __k
                    }
                    Ok(__other) => {
                        let mut __k = String::from('\u{2}');
                        __k.push_str(&__other.to_string());
                        __k
                    }
                    Err(_) => String::from('\u{3}'),
                }
            };
            let mut __empty = false;
            if let Some(__set) = self.author_id_index.get_mut(&__k) {
                __set.remove(&(id));
                __empty = __set.is_empty();
            }
            if __empty {
                self.author_id_index.remove(&__k);
            }
        }
        {
            let __k: String = {
                match serde_json::to_value(&(record.editor_id)) {
                    Ok(serde_json::Value::Null) => String::from('\u{0}'),
                    Ok(serde_json::Value::String(__s)) => {
                        let mut __k = String::from('\u{1}');
                        __k.push_str(&__s);
                        __k
                    }
                    Ok(__other) => {
                        let mut __k = String::from('\u{2}');
                        __k.push_str(&__other.to_string());
                        __k
                    }
                    Err(_) => String::from('\u{3}'),
                }
            };
            let mut __empty = false;
            if let Some(__set) = self.editor_id_index.get_mut(&__k) {
                __set.remove(&(id));
                __empty = __set.is_empty();
            }
            if __empty {
                self.editor_id_index.remove(&__k);
