    pub fn find_by_author_id_at(
        &self,
        snap: &forgedb_storage::Snapshot,
        value: Uuid,
    ) -> Vec<Post> {
        let __k: String = {
            match serde_json::to_value(&(value)) {
                Ok(serde_json::Value::Null) => String::from('\u{0}'),
                Ok(serde_json::Value::String(__s)) => {
                    let mut __k = String::from('\u{1}');
                    __k.push_str(&__s);
                    __k
                }
                Ok(__other) => {
                    let mut __k = String::from('\u{2}');
                    __k.push_str(&__other.to_string());
                    __k
                }
                Err(_) => String::from('\u{3}'),
            }
        };
        let __ids = match self.author_id_index.get(&__k) {
            Some(__s) => __s,
            None => return Vec::new(),
        };
        let mut __out = Vec::new();
        for &__id in __ids {
            if let Some(__rec) = self.get_at(snap, __id) {
                let __rk: String = {
                    match serde_json::to_value(&(__rec.author_id)) {
                        Ok(serde_json::Value::Null) => String::from('\u{0}'),
                        Ok(serde_json::Value::String(__s)) => {
                            let mut __k = String::from('\u{1}');
                            __k.push_str(&__s);
                            __k
                        }
                        Ok(__other) => {
                            let mut __k = String::from('\u{2}');
                            __k.push_str(&__other.to_string());
                            __k
                        }
                        Err(_) => String::from('\u{3}'),
                    }
                };
                if __rk == __k {
                    __out.push(__rec);
                }
            }
        }
        __out
    }
    ///Snapshot-scoped index probe for `Post`.`editor_id` (#90/#56): O(1) candidate lookup, each resolved through `get_at` (the version live as of `snap`) and post-filtered so a candidate whose value changed after the snapshot is excluded.  Honest limit: a row whose value changed *away* between the snapshot and now is not in the (unversioned) index.
    pub fn find_by_editor_id_at(
        &self,
        snap: &forgedb_storage::Snapshot,
        value: Option<Uuid>,
    ) -> Vec<Post> {
        let __k: String = {
            match serde_json::to_value(&(value)) {
                Ok(serde_json::Value::Null) => String::from('\u{0}'),
                Ok(serde_json::Value::String(__s)) => {
                    let mut __k = String::from('\u{1}');
                    __k.push_str(&__s);
                    __k
                }
                Ok(__other) => {
                    let mut __k = String::from('\u{2}');
                    __k.push_str(&__other.to_string());
                    __k
                }
                Err(_) => String::from('\u{3}'),
            }
        };
        let __ids = match self.editor_id_index.get(&__k) {
            Some(__s) => __s,
            None => return Vec::new(),
        };
        let mut __out = Vec::new();
        for &__id in __ids {
            if let Some(__rec) = self.get_at(snap, __id) {
                let __rk: String = {
                    match serde_json::to_value(&(__rec.editor_id)) {
                        Ok(serde_json::Value::Null) => String::from('\u{0}'),
                        Ok(serde_json::Value::String(__s)) => {
                            let mut __k = String::from('\u{1}');
                            __k.push_str(&__s);
                            __k
                        }
                        Ok(__other) => {
                            let mut __k = String::from('\u{2}');
                            __k.push_str(&__other.to_string());
                            __k
                        }
                        Err(_) => String::from('\u{3}'),
                    }
                };
                if __rk == __k {
                    __out.push(__rec);
                }
            }
        }
        __out
    }
}
