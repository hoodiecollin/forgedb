///Change-feed event: a `Author` was inserted (#62).
#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]
pub struct AuthorInserted {
    pub author: Author,
}
///Change-feed event: a `Author` was updated (#66); carries the new version.
#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]
pub struct AuthorUpdated {
    pub author: Author,
}
///Change-feed event: a `Author` was deleted (#66); carries the record as it was before deletion.
#[derive(Debug, Clone, Serialize, Deserialize, ToSchema)]
pub struct AuthorDeleted {
    pub author: Author,
}
///Change-feed event: a `Post` was inserted (#62).
