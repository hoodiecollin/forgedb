    pub fn read_at(&self, row_index: usize) -> Option<Post> {
        if self.tombstones.is_deleted(row_index).unwrap_or(true) {
            return None;
        }
        let id_value = {
            let bytes = self
                .id_col
                .read_uuid(row_index)
                .expect("Failed to read from column");
            Uuid::from_bytes(bytes)
        };
        let title_value = self
            .title_col
            .read_string(row_index)
            .expect("Failed to read string");
        let author_id_value = {
            let bytes = self
                .author_id_col
                .read_uuid(row_index)
                .expect("Failed to read from column");
            Uuid::from_bytes(bytes)
        };
        let editor_id_value: Option<Uuid> = {
            let bytes = self
                .editor_id_col
                .read_bytes(row_index)
                .expect("Failed to read from column");
            unsafe { std::ptr::read_unaligned(bytes.as_ptr() as *const Option<Uuid>) }
        };
