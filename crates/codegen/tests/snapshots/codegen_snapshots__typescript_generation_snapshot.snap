/**
 * Generated by ForgeDB
 * DO NOT EDIT - This file is auto-generated
 */

export interface Author {
  id: string;
}


export interface Post {
  id: string;
  title: string;
  author_id: any;
  editor_id: any | null;
}


export class ForgeDBClient {
  private baseUrl: string;

  constructor(baseUrl: string = 'http://localhost:3000') {
    this.baseUrl = baseUrl;
  }

  async getAuthor(id: string): Promise<Author | null> {
    const response = await fetch(`${this.baseUrl}/api/author/${id}`);
    if (!response.ok) return null;
    const data = await response.json();
    return data.data;
  }

  async listAuthor(): Promise<Author[]> {
    const response = await fetch(`${this.baseUrl}/api/author`);
    const data = await response.json();
    return data.data || [];
  }

  async createAuthor(data: Omit<Author, 'id'>): Promise<Author> {
    const response = await fetch(`${this.baseUrl}/api/author`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await response.json();
    return result.data;
  }

  async getPost(id: string): Promise<Post | null> {
    const response = await fetch(`${this.baseUrl}/api/post/${id}`);
    if (!response.ok) return null;
    const data = await response.json();
    return data.data;
  }

  async listPost(): Promise<Post[]> {
    const response = await fetch(`${this.baseUrl}/api/post`);
    const data = await response.json();
    return data.data || [];
  }

  async createPost(data: Omit<Post, 'id'>): Promise<Post> {
    const response = await fetch(`${this.baseUrl}/api/post`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await response.json();
    return result.data;
  }

}
