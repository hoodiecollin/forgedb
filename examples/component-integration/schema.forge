// Example schema demonstrating UI Component Integration (Sprint 17)
// This shows how to define component fields for React components and API routes

User {
  // Primary key
  id: +uuid

  // Basic fields
  name: string
  email: string @email
  avatar: string
  bio: string

  // Relations
  posts: [Post]
  comments: [Comment]

  // TSX Component: User profile card with all relations
  // @relations(*) includes all relation fields (posts, comments) in the props
  profileCard: tsx://components/user/ProfileCard @relations(*)

  // JSX Component: Avatar display with specific relations
  // Only includes the posts relation in the component props
  avatarView: jsx://components/user/AvatarView @relations(posts)

  // API Routes
  updateProfile: api://routes/user/update
  deleteAccount: api://routes/user/delete
}

Post {
  id: +uuid
  title: string @length(1, 200)
  content: string
  published: bool
  createdAt: +timestamp

  // Relations
  author: *User
  comments: [Comment]
  tags: [Tag]

  // TSX Component: Post preview card with author relation
  previewCard: tsx://components/post/PreviewCard @relations(author)

  // TSX Component: Full post view with all relations
  fullView: tsx://components/post/FullView @relations(author, comments, tags)

  // API Routes
  publish: api://routes/post/publish
  unpublish: api://routes/post/unpublish
}

Comment {
  id: +uuid
  text: string
  createdAt: +timestamp

  // Relations
  author: *User
  post: *Post

  // JSX Component: Comment item (no relations included)
  item: jsx://components/comment/Item

  // API Routes
  edit: api://routes/comment/edit
  delete: api://routes/comment/delete
}

Tag {
  id: +uuid
  name: &string
  color: string

  // Relations
  posts: [Post]

  // TSX Component: Tag badge
  badge: tsx://components/tag/Badge
}
