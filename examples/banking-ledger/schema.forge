// Banking ledger: customers, accounts (joint ownership via explicit M2M),
// transactions (debit/credit), transfers (double-entry style), statements.
// Every monetary amount is a `decimal`: exact fixed-point, so a balance is the
// sum of its entries to the last digit. Ledger entries are keyed by their
// posting instant (`id: +timestamp(us)`), allocated and strictly increasing.
// Provenance: Synthetic (modeled after the standard banking ledger design pattern)

Customer {
  id: +uuid
  first_name: string @length(1, 50)
  last_name: string @length(1, 50)
  email: &string @email
  phone: string?
  date_of_birth: timestamp?
  account_owners: [AccountOwner]
  created_at: +timestamp
}

// kind: checking | savings | credit | investment
Account {
  id: +uuid
  // human-readable account number, e.g. "1234567890"
  account_number: &string @length(10, 20)
  kind: string @length(1, 20)
  // exact fixed-point; may go negative on a credit account
  balance: decimal
  // ISO 4217 currency code, e.g. "USD" — text, so `string` with an exact length
  currency: string @length(3, 3)
  opened_at: +timestamp
  closed_at: timestamp?
  owners: [AccountOwner]
  transactions: [Transaction]
  statements: [Statement]
  created_at: +timestamp
}

// Explicit join model enabling joint accounts (Customer <-> Account M2M).
// role: primary | joint | authorized
AccountOwner {
  id: +uuid
  customer: *Customer
  account: *Account
  role: string @length(1, 20)
  added_at: +timestamp
  @index(customer, account)
}

// kind: debit | credit
// The identity is the posting instant: a `+timestamp(us)` key is allocated as
// `max(now, last + 1)`, so entries posted in one burst still get distinct,
// strictly increasing keys. `occurred_at` is the business time and can differ
// from it (a backdated correction posts now but occurred then).
Transaction {
  id: +timestamp(us)
  account: *Account
  kind: string @length(1, 10)
  // exact fixed-point; strictly positive (the sign lives in `kind`)
  amount: decimal @min(>0)
  description: string?
  reference: string?
  occurred_at: +timestamp
  created_at: +timestamp
  @index(account, occurred_at)
}

// A transfer represents a debit on from_account and a credit on to_account.
Transfer {
  id: +uuid
  from_account: *Account
  to_account: *Account
  // exact fixed-point; strictly positive
  amount: decimal @min(>0)
  description: string?
  occurred_at: +timestamp
  created_at: +timestamp
  @index(from_account, occurred_at)
}

Statement {
  id: +uuid
  account: *Account
  period_start: timestamp
  period_end: timestamp
  opening_balance: decimal
  closing_balance: decimal
  generated_at: +timestamp
  created_at: +timestamp
  @index(account, period_start)
}
